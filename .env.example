# Copy to .env and fill in. Never commit .env.

# Crusoe Managed Inference (console → Admin → Security → Intelligence API keys)
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL=moonshotai/Kimi-K2.6
CRUSOE_SCOUT_MODEL=deepseek-ai/Deepseek-V4-Flash
CRUSOE_PLANNER_MODEL=deepseek-ai/DeepSeek-V4-Pro
# a second, different open model for the Checker's review (optional)
CRUSOE_CHECKER_MODEL=google/gemma-4-31b-it

# Neo4j AuraDB (console.neo4j.io → your instance → the credentials file)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Band (app.band.ai → Agents → New agent → External; copy the Agent UUID and the API key of each)
BAYBAY_AGENT_ID=
BAYBAY_API_KEY=
SCOUT_AGENT_ID=
SCOUT_API_KEY=
PLANNER_AGENT_ID=
PLANNER_API_KEY=
CHECKER_AGENT_ID=
CHECKER_API_KEY=
# optional: an existing room with all four agents in it (else BAYBAY creates one and adds the others)
BAND_ROOM_ID=

PORT=8787
