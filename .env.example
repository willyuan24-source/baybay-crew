# Copy to .env and fill in. Never commit .env. Every value is optional: a service without keys runs locally (and is
# labelled so in the UI); a blank value means the default.

# Crusoe Managed Inference (console → Admin → Security → Intelligence API keys)
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# one open model per agent; model ids are case-sensitive and must match /v1/models
CRUSOE_SCOUT_MODEL=deepseek-ai/Deepseek-V4-Flash
CRUSOE_PLANNER_MODEL=deepseek-ai/DeepSeek-V4-Pro
# a second, different open model for the Checker's review
CRUSOE_CHECKER_MODEL=google/gemma-4-31b-it
# only a fallback: no agent uses it (a blank agent model above means that agent's default, not this one)
CRUSOE_MODEL=deepseek-ai/Deepseek-V4-Flash

# Neo4j AuraDB (console.neo4j.io → your instance → the credentials file). Use a dedicated, empty database:
# npm run load replaces every :Entity node in it.
NEO4J_URI=
# the user name from Aura's credentials file (for newer instances it is the instance id); blank = neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
# blank = the instance's default database
NEO4J_DATABASE=

# Band (app.band.ai → Agents → New agent → External; copy the Agent UUID and the API key of each)
BAYBAY_AGENT_ID=
BAYBAY_API_KEY=
SCOUT_AGENT_ID=
SCOUT_API_KEY=
PLANNER_AGENT_ID=
PLANNER_API_KEY=
CHECKER_AGENT_ID=
CHECKER_API_KEY=
# optional: an existing room with all four agents in it (else BAYBAY creates a new one at every start and adds the others)
BAND_ROOM_ID=
# how often each agent asks Band for its next message, in ms
BAND_POLL_MS=800

# The web server. 127.0.0.1 = this machine only; 0.0.0.0 also serves your network, with no auth: anyone who can reach it
# can start runs that spend your Crusoe credits and post into your Band room.
HOST=127.0.0.1
PORT=8787
# more Host names to answer, comma-separated (e.g. a tunnel or proxy name); any other Host gets 403
ALLOWED_HOSTS=
